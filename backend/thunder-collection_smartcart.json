      "body": {
        "type": "json",
        "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@gmail.com\",\n  \"password\": \"test1234\"\n}"
      },
      "params": [],
      "tests": [
        { "type": "status", "value": "201", "action": "equal" }
      ]
    },
